# PostgreSQL Database Connection URL (AsyncPG)
# Example for Neon Cloud: postgresql+asyncpg://user:pass@ep-cool-cloud.neon.tech/neondb?ssl=require
# Example for Local Docker: postgresql+asyncpg://maktab_user:maktab_secret_123@localhost:5432/maktab_db
DATABASE_URL=postgresql+asyncpg://maktab_user:maktab_secret_123@localhost:5432/maktab_db

# Security & Authentication Secrets
SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial School Admin Seed
DEFAULT_ADMIN_EMAIL=admin@maktab142.uz
DEFAULT_ADMIN_PASSWORD=Admin123!
