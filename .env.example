# ==========================================
# PostgreSQL (Docker Compose uchun majburiy)
# ==========================================
POSTGRES_USER=maktab_owner
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=maktab_db

# Ilova uchun egasi BO'LMAGAN, NOBYPASSRLS roli (RLS ishlashi uchun majburiy)
DATABASE_URL=postgresql+asyncpg://maktab_app:maktab_app_secret@postgres:5432/maktab_db

# Migratsiyalar (alembic upgrade head) uchun jadval egasi (owner) roli
ALEMBIC_DATABASE_URL=postgresql+asyncpg://maktab_owner:change_this_strong_postgres_password@postgres:5432/maktab_db

# ==========================================
# Backend Xavfsizlik & JWT (Majburiy)
# ==========================================
# Kamida 32 belgili tasodifiy maxfiy kalit (masalan: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_long_random_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# ==========================================
# Boshlang'ich Admin (init_db.py uchun majburiy)
# ==========================================
DEFAULT_ADMIN_EMAIL=admin@maktab142.uz
DEFAULT_ADMIN_PASSWORD=change_this_admin_password

# ==========================================
# Frontend (Next.js 14)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
