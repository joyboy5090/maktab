# ==========================================
# PostgreSQL (Docker Compose uchun majburiy)
# ==========================================
POSTGRES_USER=maktab_user
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=maktab_db

# Backend uchun Async PostgreSQL ulanish manzili (Docker ichida host: postgres)
DATABASE_URL=postgresql+asyncpg://maktab_user:change_this_strong_postgres_password@postgres:5432/maktab_db

# ==========================================
# Backend Xavfsizlik & JWT (Majburiy)
# ==========================================
# Kamida 32 belgili tasodifiy maxfiy kalit (masalan: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_long_random_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Boshlang'ich Admin (init_db.py uchun majburiy)
# ==========================================
DEFAULT_ADMIN_EMAIL=admin@maktab142.uz
DEFAULT_ADMIN_PASSWORD=change_this_admin_password

# ==========================================
# Frontend (Next.js 14)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
